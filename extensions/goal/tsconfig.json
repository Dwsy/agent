{
  "compilerOptions": {
    "target": "ES2022",
    "module": "ES2022",
    "moduleResolution": "bundler",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "noEmit": true,
    "outDir": "./dist",
    "rootDir": ".",
    "declaration": true,
    "noUnusedLocals": false,
    "noUnusedParameters": false,
    "paths": {
      "@earendil-works/pi-coding-agent": ["./typings/pi-coding-agent.d.ts"],
      "@sinclair/typebox": ["./typings/typebox.d.ts"]
    }
  },
  "include": ["*.ts", "typings/**/*.d.ts"],
  "exclude": ["node_modules", "dist"]
}
